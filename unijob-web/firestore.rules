rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // USERS: chỉ đọc public info, chỉ chủ tài khoản mới sửa được
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // JOBS: ai đăng nhập cũng đọc được, chỉ người đăng mới sửa/xóa
    match /jobs/{jobId} {
      // chuyển trạng thái của người đăng: open -> in-progress (chỉ trong cùng lần ghi giao việc),
      // open/in-progress -> cancelled, in-progress -> completed (TODO slice 5: chuyển sang server).
      // Không bao giờ quay lại 'open'.
      function posterStatusChangeOk() {
        let from = resource.data.status;
        let to = request.resource.data.status;
        return (from == 'open' && to == 'in-progress'
            && 'assignedTo' in request.resource.data.diff(resource.data).affectedKeys()
            && request.resource.data.assignedTo.size() == 1)
          || (from in ['open', 'in-progress'] && to == 'cancelled')
          || (from == 'in-progress' && to == 'completed');
      }
      // đơn được giao phải thuộc đúng job này, đúng người được giao và đã được chấp nhận
      function assignedAppOk(app) {
        return app.status == 'accepted'
          && app.jobId == jobId
          && app.applicantId == request.resource.data.assignedTo[0];
      }
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'faculty', 'location', 'isUrgent', 'isAnonymous',
          'payment', 'paymentType', 'duration', 'deadline', 'maxApplicants', 'postedBy',
          'postedByName', 'postedByPhoto', 'tags', 'attachments',
          'status', 'applicants', 'assignedTo', 'createdAt', 'updatedAt'])
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.applicants == []
        && request.resource.data.assignedTo == [];
      allow update: if isAuth() && (
        // người đăng: sửa mọi thứ trừ postedBy
        (resource.data.postedBy == request.auth.uid
          && request.resource.data.postedBy == resource.data.postedBy
          // poster không sửa danh sách applicants
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['applicants'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || posterStatusChangeOk())
          // giao việc: chỉ khi job còn 'open', tối đa 1 người, phải có đơn đã được chấp nhận của job này
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTo'])
            || (resource.data.status == 'open'
              && request.resource.data.assignedTo is list
              && request.resource.data.assignedTo.size() <= 1
              && (request.resource.data.assignedTo.size() == 0
                || assignedAppOk(getAfter(/databases/$(database)/documents/applications/$(jobId + '_' + request.resource.data.assignedTo[0])).data))))) ||
        // người khác: chỉ thêm/bớt chính mình trong applicants (+ updatedAt)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicants', 'updatedAt'])
          && request.resource.data.applicants is list
          && (!('updatedAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.updatedAt == request.time)
          && (
            // ứng tuyển: danh sách mới = cũ + uid của mình
            (resource.data.status == 'open'
              && !(request.auth.uid in resource.data.applicants)
              && request.resource.data.applicants.size() == resource.data.applicants.size() + 1
              && request.resource.data.applicants.toSet().difference(resource.data.applicants.toSet())
                   == [request.auth.uid].toSet()
              && resource.data.applicants.toSet().difference(request.resource.data.applicants.toSet()).size() == 0) ||
            // rút đơn: danh sách mới = cũ - uid của mình
            (request.auth.uid in resource.data.applicants
              && request.resource.data.applicants.size() == resource.data.applicants.size() - 1
              && resource.data.applicants.toSet().difference(request.resource.data.applicants.toSet())
                   == [request.auth.uid].toSet()
              && request.resource.data.applicants.toSet().difference(resource.data.applicants.toSet()).size() == 0)
          ))
      );
      allow delete: if isAuth() && resource.data.postedBy == request.auth.uid;
    }

    // APPLICATIONS: applicant đọc được đơn của mình, poster đọc đơn vào job của mình
    match /applications/{appId} {
      function canReadApp() {
        return resource.data.applicantId == request.auth.uid ||
          // poster đọc: cần check qua jobs collection
          exists(/databases/$(database)/documents/jobs/$(resource.data.jobId)) &&
          get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid;
      }
      // get đơn chưa tồn tại: chỉ được hỏi id của chính mình (jobId_uid) để kiểm tra đã ứng tuyển chưa
      allow get: if isAuth() && (
        (resource == null && appId.matches('^.+_' + request.auth.uid + '$')) ||
        (resource != null && canReadApp()));
      allow list: if isAuth() && canReadApp();
      // mỗi người một đơn cho mỗi job: id = jobId_uid
      allow create: if isAuth()
        && appId == request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['jobId', 'applicantId', 'applicantName', 'applicantPhoto', 'message', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.applicantName is string
        && request.resource.data.applicantName.size() <= 100
        && request.resource.data.applicantPhoto is string
        && request.resource.data.applicantPhoto.size() <= 2048
        && (request.resource.data.applicantPhoto == '' || request.resource.data.applicantPhoto.matches('^https://.*'))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.postedBy != request.auth.uid
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'open';
      // chỉ poster của job quyết định một lần (pending -> accepted/rejected)
      allow update: if isAuth()
        && resource.data.status == 'pending'
        && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy == request.auth.uid
        // chỉ khi job còn 'open' (get() = trạng thái trước batch, nên batch chấp nhận vẫn qua)
        && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected']
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    // RATINGS: ai đăng nhập cũng đọc, chỉ người trong job mới tạo được
    match /ratings/{ratingId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['jobId', 'fromUserId', 'toUserId', 'score', 'comment', 'type', 'createdAt'])
        && request.resource.data.keys().hasAll(['jobId', 'fromUserId', 'toUserId', 'score', 'comment', 'type', 'createdAt'])
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.resource.data.fromUserId
        && ratingId == request.resource.data.jobId + '_' + request.resource.data.fromUserId + '_' + request.resource.data.toUserId
        && request.resource.data.score is int
        && request.resource.data.score >= 1 && request.resource.data.score <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.jobId is string
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'completed'
        && (
          (request.resource.data.type == 'poster-to-worker'
            && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.postedBy == request.auth.uid
            && request.resource.data.toUserId in get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.assignedTo)
          || (request.resource.data.type == 'worker-to-poster'
            && request.auth.uid in get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.assignedTo
            && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.postedBy == request.resource.data.toUserId)
        );
      allow update, delete: if false;
    }

    // JOB COMPLETIONS: người trong job mới đọc/update được
    match /jobCompletions/{completionId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // WORK HISTORY: public read
    match /workHistory/{historyId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // NOTIFICATIONS: chỉ chủ sở hữu đọc/update, ai auth cũng tạo được
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    // PAYMENTS: payer hoặc payee mới đọc được, hệ thống (auth user) mới tạo/update được
    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.payerId == request.auth.uid ||
        resource.data.payeeId == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.payerId == request.auth.uid ||
        resource.data.payeeId == request.auth.uid
      );
      allow delete: if false;
    }
  }
}